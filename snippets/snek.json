{
  "Function Definition": {
    "prefix": "fun",
    "body": [
      "(fun (${1:name} ${2:param})",
      "  ${3:body})"
    ],
    "description": "Define a Snek function"
  },
  "Let Binding": {
    "prefix": "let",
    "body": [
      "(let ((${1:name} ${2:expr}))",
      "  ${3:body})"
    ],
    "description": "Create a local binding"
  },
  "If Expression": {
    "prefix": "if",
    "body": "(if ${1:condition} ${2:then-expr} ${3:else-expr})",
    "description": "Create an if expression"
  },
  "Block": {
    "prefix": "block",
    "body": [
      "(block",
      "  ${1:expr}",
      "  ${2:expr})"
    ],
    "description": "Evaluate expressions in order"
  },
  "Loop": {
    "prefix": "loop",
    "body": [
      "(loop",
      "  ${1:expr})"
    ],
    "description": "Create a loop expression"
  },
  "Vector": {
    "prefix": "vec",
    "body": "(vec ${1:expr})",
    "description": "Create a vector"
  }
}
